# Ghostty Terminal Configuration
# Docs: https://ghostty.org/docs/config
# Style: Dark minimal with purple tones (Night Owl)

# Theme
theme = Night Owl

# Font - Fira Code with ligatures
font-family = Fira Code
font-size = 16
font-thicken = true

# Window
window-padding-x = 12
window-padding-y = 12
window-decoration = true
window-save-state = always

# macOS - Tabs in titlebar for clean look
macos-titlebar-style = tabs
macos-option-as-alt = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Scrollback
scrollback-limit = 10000

# Mouse
mouse-hide-while-typing = true
copy-on-select = clipboard

# Shell integration
shell-integration-features = cursor

# Unfocused splits - subtle dimming for heavy split usage
unfocused-split-opacity = 0.85

# Quick terminal (kept from your original config)
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.1

# ----------------------------------
# Keybindings - Vim-style navigation
# ----------------------------------

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab

# Splits - create
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = ctrl+alt+left=new_split:left
keybind = ctrl+alt+right=new_split:right
keybind = ctrl+alt+up=new_split:up
keybind = ctrl+alt+down=new_split:down

# Splits - vim-style navigation (direct)
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top
keybind = ctrl+l=goto_split:right

# Splits - also keep direct navigation as alternative
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:top
keybind = cmd+opt+down=goto_split:bottom

# Splits - resize with vim-style (ctrl+w then shift+h/j/k/l)
keybind = ctrl+w>shift+h=resize_split:left,50
keybind = ctrl+w>shift+j=resize_split:down,50
keybind = ctrl+w>shift+k=resize_split:up,50
keybind = ctrl+w>shift+l=resize_split:right,50

# Splits - equalize
keybind = ctrl+w>equal=equalize_splits

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Misc
keybind = shift+enter=text:\x1b\r
